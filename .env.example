# Copy this file to .env and fill in the real values. .env is gitignored.

# Webhook the slack-notifier posts alerts to.
#   discord: https://discord.com/api/webhooks/<id>/<token>
#   slack:   https://hooks.slack.com/services/<T...>/<B...>/<token>
WEBHOOK_URL=

# Which service that webhook belongs to: discord or slack.
PLATFORM=discord
